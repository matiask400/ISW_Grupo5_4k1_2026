# URL del backend. Dejalo vacío en desarrollo: Vite redirige /api al backend
# (ver "proxy" en vite.config.ts). En producción poné la URL real, por ejemplo:
# VITE_API_URL=https://api.ecoharmonypark.com
VITE_API_URL=

# true: simula la compra en el frontend; false/omitido: usa el endpoint del backend.
VITE_API_MOCK=true
